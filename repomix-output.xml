import sys

def run_tests():
    # On Windows, pytest might not be in the PATH as an executable, 
    # but it is available as a module.
    try:
        result = subprocess.run([sys.executable, '-m', 'pytest'], capture_output=True, text=True)
        print(result.stdout)
        print(result.stderr)
