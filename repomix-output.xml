    def test_sandbox_is_real_deep_copy_not_symlink(self, tmp_path):
        source_repo = tmp_path / "source_repo"
        source_repo.mkdir()
        test_file = source_repo / "module.py"
        test_file.write_text("original_content = 1\n")

        runner = BenchmarkRunner()
