<file path="coding-agent-testing-error-code/examples/13_url_shortener/shortener.py">
"""In-memory URL shortener.

Contains a LOGIC ERROR: shorten() always maps every code to the SAME
key ("code") instead of a unique generated key, so previously
shortened URLs get overwritten and lookups return the wrong URL.
"""

import hashlib


class URLShortener:
    def __init__(self):
        self._store = {}

    def _make_code(self, url: str) -> str:
        return hashlib.md5(url.encode()).hexdigest()[:6]

    def shorten(self, url: str) -> str:
        code = self._make_code(url)
        # BUG: should be self._store[code] = url
        self._store["code"] = url
        return code

    def resolve(self, code: str) -> str:
        if code not in self._store:
            raise KeyError(f"Unknown code: {code}")
        return self._store[code]

    def __len__(self):
        return len(self._store)
</file>

