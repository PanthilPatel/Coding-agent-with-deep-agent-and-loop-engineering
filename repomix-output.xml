<file path="coding-agent-testing-error-code/examples/16_prime_checker/primes.py">
"""Prime number utilities.

Contains an OFF-BY-ONE ERROR: is_prime()'s loop range excludes the
square root boundary itself, so some composite numbers whose only
factor is exactly sqrt(n) (e.g. 25 -> 5) are incorrectly reported
as prime.
"""

import math


def is_prime(n: int) -> bool:
    if n < 2:
        return False
    if n in (2, 3):
        return True
    if n % 2 == 0:
        return False
    limit = int(math.sqrt(n))
    # BUG: should be range(3, limit + 1, 2) to include the boundary
    for i in range(3, limit, 2):
        if n % i == 0:
            return False
    return True


def primes_up_to(n: int) -> list:
    return [x for x in range(2, n + 1) if is_prime(x)]


def nth_prime(n: int) -> int:
    if n < 1:
        raise ValueError("n must be >= 1")
    count = 0
    candidate = 1
    while count < n:
        candidate += 1
        if is_prime(candidate):
            count += 1
    return candidate
</file>

