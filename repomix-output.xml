Contains a classic MUTABLE DEFAULT ARGUMENT bug: add_score()'s
`history=[]` default is created once and shared across every call
that doesn't pass its own list, so scores leak between students.
"""


def add_score(score: float, history=[]) -> list:
    # BUG: default mutable argument is shared across calls.
    # Should be: def add_score(score, history=None): history = history if history is not None else []
    history.append(score)
    return history


def average(scores: list) -> float:
    if not scores:
        raise ValueError("scores must not be empty")
    return sum(scores) / len(scores)


def letter_grade(avg: float) -> str:
    if avg >= 90:
        return "A"
    elif avg >= 80:
        return "B"
    elif avg >= 70:
        return "C"
    elif avg >= 60:
        return "D"
    return "F"
