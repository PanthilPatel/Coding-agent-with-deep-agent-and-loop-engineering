"""Simple key=value config file parser.

Contains a LOGIC ERROR: parse() silently swallows malformed lines
AND invalid integers via a bare except, returning incomplete/wrong
data instead of raising, which hides real errors from callers.
"""


def parse(text: str) -> dict:
    result = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if value.isdigit():
                value = int(value)
            result[key] = value
        except Exception:
            # BUG: silently drops malformed lines instead of raising
            # ValueError(f"Malformed config line: {line!r}")
            continue
    return result


def get_int(config: dict, key: str, default: int = 0) -> int:
    value = config.get(key, default)
    if isinstance(value, int):
        return value
    raise TypeError(f"Config value for {key!r} is not an int: {value!r}")
</file>

