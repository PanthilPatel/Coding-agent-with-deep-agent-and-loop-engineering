            cwd=str(tmp_path),
            stdout_match=str(tmp_path).replace("\\", "/").split("/")[-1],
        )
        # Just verify the call doesn't crash; cwd handling is validated by
        # the presence of the path component in stdout.
        assert result.strategy == "command_execution"


